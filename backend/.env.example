# Database
DATABASE_URL=postgres://conduit:conduit_dev@localhost:5432/conduit
DATABASE_MAX_CONNECTIONS=10

# Redis
REDIS_URL=redis://127.0.0.1:6379

# Server
CONDUIT_HOST=0.0.0.0
CONDUIT_PORT=8080

# Auth — CHANGE THIS IN PRODUCTION
JWT_SECRET=dev-secret-change-me-in-production

# CORS — comma-separated origins, use "*" for development
CORS_ORIGINS=http://localhost:3000

# Logging (optional)
RUST_LOG=conduit=debug,tower_http=debug

# ---------------------------------------------------------------------------
# M-Pesa Daraja API
# ---------------------------------------------------------------------------
# Set DARAJA_SIM_MODE=true for local development (no Safaricom credentials needed)
# Set DARAJA_SIM_MODE=false in production to hit the real Daraja API
DARAJA_SIM_MODE=true

# Consumer key and secret from https://developer.safaricom.co.ke
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=

# Base URL — sandbox for dev, production for live
# Overrides: defaults to sandbox when SIM_MODE=true, production when false
DARAJA_BASE_URL=

# Public URL where Safaricom sends async B2C/STK results
# Must be reachable from the internet in production
DARAJA_CALLBACK_URL=http://localhost:8080/api/v1/mpesa/b2c-callback

# Passkey from Safaricom Daraja portal (needed for STK Push)
DARAJA_PASSKEY=

# Your till number or paybill short code
DARAJA_SHORT_CODE=174379

# Initiator name registered with Safaricom
DARAJA_INITIATOR_NAME=conduit
